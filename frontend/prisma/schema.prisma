generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  address    String   @db.VarChar(255)
  gender     Gender
  phone      String   @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)  // ← tambah @default(now())

  @@map("members")
}

model FellowshipEvent {
  id                  Int         @id @default(autoincrement())
  month               String      @db.VarChar(50)
  date                DateTime    @db.Date
  theme               String      @db.VarChar(255)
  bible_verse         String      @db.VarChar(255)
  objective           String
  theme_description   String
  speaker             String      @db.VarChar(255)
  speaker_pic         String      @db.VarChar(255)
  speaker_status      EventStatus @default(NOT_DONE)       // ← tambah @default
  mc                  String      @db.VarChar(255)
  musician            String      @db.VarChar(255)
  worship_team_pic    String      @db.VarChar(255)
  worship_team_status EventStatus @default(NOT_DONE)       // ← tambah @default
  attendance_count    Int         @default(0)              // ← tambah @default(0)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime    @updatedAt @db.Timestamptz(6)

  @@map("fellowship_events")
}

model AppFile {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  url         String   @db.VarChar(200)
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)  // ← tambah @default(now())

  @@map("files")
}

enum Gender {
  M
  F
}

enum EventStatus {
  DONE
  NOT_DONE
}